{
  "name": "deevs-pi-kit",
  "version": "0.1.0",
  "description": "Portable Pi package with bounded Jobs, curated Subagents, session Cron, Chains, research tools, and skills",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:anti-slop": "oxlint extensions/runtime extensions/chains extensions/shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "node scripts/audit.mjs",
    "bench:context": "node --experimental-strip-types bench/context.mjs",
    "bench:protocol": "node --experimental-strip-types bench/protocol/all.mjs",
    "smoke:native-release": "vitest run test/hosted-runtime-bridge.test.ts test/hosted-runtime-participant.test.ts test/runtime-worktree.test.ts",
    "check": "npm run lint:anti-slop && npm run typecheck && npm test && npm run polygon && npm run audit && npm pack --dry-run",
    "sync:chains-plugin": "node scripts/sync-chains-plugin.mjs",
    "polygon": "node polygon/run.mjs"
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "agent-skills"
  ],
  "pi": {
    "extensions": [
      "./extensions/*/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@oxlint/plugins": "1.80.0",
    "@types/node": "^22.19.0",
    "js-tiktoken": "^1.0.21",
    "oxlint": "1.80.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@earendil-works/pi-durable": "1.0.4",
    "runtime-typebox": "npm:typebox@1.3.27"
  }
}
