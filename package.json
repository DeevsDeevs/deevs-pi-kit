{
  "name": "deevs-pi-kit",
  "version": "0.1.0",
  "description": "Pi package with durable Agent and Workflow tools, todos, ask_user, codex-fast and an hc hint",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "node scripts/audit.mjs",
    "check": "npm run typecheck && npm test && npm run audit && npm pack --dry-run"
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "subagents",
    "workflows"
  ],
  "pi": {
    "extensions": [
      "./extensions/*/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^22.19.0",
    "js-tiktoken": "^1.0.21",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0"
  }
}
