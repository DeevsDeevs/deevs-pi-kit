{
  "name": "deevs-pi-kit",
  "version": "0.1.0",
  "description": "Portable Pi package with bounded Jobs, curated Subagents, Missions, session Cron, Chains, workflows, research tools, and skills",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "node scripts/audit.mjs",
    "smoke:modes": "node scripts/smoke-modes.mjs",
    "smoke:runtime-release": "node --experimental-strip-types scripts/smoke-runtime-release.mjs",
    "smoke:collaborator-release": "node --experimental-strip-types scripts/smoke-collaborator-release.mjs",
    "smoke:collaborator-auto-release": "PI_KIT_SMOKE_AUTO=1 node --experimental-strip-types scripts/smoke-collaborator-release.mjs",
    "smoke:native-release": "vitest run test/native-collaborator-release.test.ts",
    "smoke:native-live": "node --experimental-strip-types scripts/smoke-native-live.mjs",
    "check": "npm run typecheck && npm test && npm run smoke:modes && npm run audit && npm pack --dry-run"
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "agent-skills"
  ],
  "pi": {
    "extensions": [
      "./extensions/*/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.82.0",
    "@earendil-works/pi-coding-agent": ">=0.82.0",
    "@earendil-works/pi-tui": ">=0.82.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.0",
    "@earendil-works/pi-coding-agent": "0.82.0",
    "@earendil-works/pi-tui": "0.82.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
